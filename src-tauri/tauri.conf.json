{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RevFly",
  "version": "0.1.13",
  "identifier": "com.revfly.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RevFly",
        "width": 340,
        "height": 100,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "RevFly",
    "copyright": "Copyright (c) 2026 Eugene Otsevich. MIT License.",
    "category": "Productivity",
    "shortDescription": "Local-first voice dictation and translation",
    "longDescription": "RevFly records your speech, transcribes it locally, optionally translates it with AI, and pastes the result into the active window.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MTUzNTdCRkRBOUFCNjIKUldSaXE2bjllelVWR2Vmajd3L1p6U0grUGtuVVRyWFdIbjFhQnEvV1FHcDBtbnJ1b0I4WHd5b1kK",
      "endpoints": [
        "https://github.com/eotsevych/RevFly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
